# ═══════════════════════════════════════════════════════════════
# AR App — متغيرات البيئة (البنية المبسّطة: Node.js + Postgres + Redis)
# ═══════════════════════════════════════════════════════════════

# ─── السرفر ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://ar-app.dz
FRONTEND_URL=https://ar-app.dz

# ─── قاعدة البيانات ───────────────────────────────────────────
# عند استخدام Neon أو أي قاعدة مُدارة، استبدل هذه القيم بمعطيات
# الاتصال التي يعطيك بها مزوّد الاستضافة
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ar_app
DB_USER=ar_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql://ar_user:CHANGE_THIS_STRONG_PASSWORD_MIN_32_CHARS@postgres:5432/ar_app

# ─── Redis ────────────────────────────────────────────────────
# عند استخدام Upstash استبدل هذه القيم بمعطيات لوحة تحكم Upstash
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_MIN_32_CHARS

# ─── JWT ──────────────────────────────────────────────────────
# ولّد بـ: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_128_CHAR_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_ANOTHER_128_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ─── البريد الإلكتروني (OTP) ──────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-app-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-16-chars
EMAIL_FROM=AR App <no-reply@ar-app.dz>
ADMIN_EMAIL=admin@ar-app.dz

# ─── الأدمن (أول Owner فقط، عبر scripts/seed-owner.js) ────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_VERY_STRONG_ADMIN_PASSWORD

# ─── كشف VPN ──────────────────────────────────────────────────
# مجاني من: https://vpnapi.io/signup
VPNAPI_KEY=your_vpnapi_key_here

# ─── تخزين الوسائط (Cloudflare R2، متوافق مع S3) ──────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=ar-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ملح Master Key، يُولَّد مرة واحدة فقط ولا يُغيَّر أبداً بعد ذلك
# ولّد بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_SALT=GENERATE_ONCE_SAVE_FOREVER_NEVER_CHANGE

# ─── AI فلترة المحتوى ────────────────────────────────────────
# فلترة النصوص والصور تعتمد كلتاهما على HuggingFace فقط الآن
# (Google أوقفت Perspective API نهائياً واستقبال مفاتيح جديدة له
# منذ فيفري 2026، فلا حاجة لهذا المتغير أصلاً)
# مجاني من: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── RBAC / Admin JWT ──────────────────────────────────────────
# ولّد بـ: openssl rand -hex 64 (يفضّل مفتاح مختلف عن JWT_SECRET)
ADMIN_JWT_SECRET=CHANGE_THIS_ADMIN_JWT_SECRET

# ─── 2FA (TOTP) ────────────────────────────────────────────────
# ولّد بـ: openssl rand -hex 32 — يُستخدم لتشفير أسرار TOTP بالقاعدة
TOTP_ENC_KEY=CHANGE_THIS_TOTP_ENCRYPTION_KEY

# ─── بوت تيليجرام للتنبيهات (اختياري، للأخطاء الحرجة فقط) ─────
# من BotFather على تيليجرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── مفاتيح العملاء (Web/Dashboard/Android/iOS) ───────────────
# ولّد كل واحد بـ: openssl rand -hex 32 — تُدخل بجدول client_keys بعد أول تشغيل
CLIENT_KEY_WEB=CHANGE_THIS_WEB_CLIENT_KEY
CLIENT_KEY_DASHBOARD=CHANGE_THIS_DASHBOARD_CLIENT_KEY
CLIENT_KEY_ANDROID=CHANGE_THIS_ANDROID_CLIENT_KEY
CLIENT_KEY_IOS=CHANGE_THIS_IOS_CLIENT_KEY

# ─── أكواد الوصول لأقسام البيانات المعزولة (Web/Android/iOS) ──
# 3 أكواد منفصلة تماماً، كود قسم لا يفتح بيانات قسم آخر أبداً
# ولّد كل واحد بـ: openssl rand -hex 24
DECRYPT_CODE_WEB=CHANGE_THIS_WEB_SECTION_CODE
DECRYPT_CODE_ANDROID=CHANGE_THIS_ANDROID_SECTION_CODE
DECRYPT_CODE_IOS=CHANGE_THIS_IOS_SECTION_CODE
