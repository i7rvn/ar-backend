# AR Backend example environment
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ar
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS

# Authentication
JWT_SECRET=CHANGE_THIS
JWT_REFRESH_SECRET=CHANGE_THIS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OTP
# false = verify OTP normally (recommended/default)
# true  = explicitly skip OTP verification
SKIP_OTP_VERIFICATION=false

# Message encryption
# Keep false to require the E2E v2 envelope protocol.
ALLOW_LEGACY_MESSAGE_ENCRYPTION=false

# Frontend / dashboard
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Client keys / external services
CLIENT_KEY=CHANGE_THIS
RESEND_API_KEY=CHANGE_THIS
EMAIL_FROM=AR App <onboarding@resend.dev>

# E2E / field encryption
TOTP_ENC_KEY=CHANGE_THIS
EMAIL_HASH_SECRET=CHANGE_THIS
DECRYPT_CODE_WEB=CHANGE_THIS
DECRYPT_CODE_ANDROID=CHANGE_THIS
DECRYPT_CODE_IOS=CHANGE_THIS

# Cloudflare R2
R2_ACCOUNT_ID=CHANGE_THIS
R2_ACCESS_KEY=CHANGE_THIS
R2_SECRET_KEY=CHANGE_THIS
R2_BUCKET_NAME=CHANGE_THIS
R2_PUBLIC_URL=https://CHANGE_THIS

# Optional bootstrap
AUTO_MIGRATE_AND_SEED=false
